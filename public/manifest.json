{
  "manifest_version": 3,
  "name": "Rino Extension",
  "version": "0.1.0",
  "description": "A browser extension built with Rino.js.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Rino Extension",
    "default_popup": "popup/index.html",
    "default_icon": "rino256.png"
  },
  "icons": {
    "256": "rino256.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inserted-pages.js", "scripts/onload/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inserted/*", "styles/inserted/*", "scripts/inserted/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rino-wxt@rinojs.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
